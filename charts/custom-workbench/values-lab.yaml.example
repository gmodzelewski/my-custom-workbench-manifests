# Lab/demo values — copy to values-lab.yaml and fill in credentials.
# values-lab.yaml is gitignored; never commit real secrets.

secrets:
  create: true
  quay:
    username: "<quay-robot-user>"
    password: "<quay-robot-token>"
  github:
    pat: "<github-pat-with-read-source-and-push-manifests>"
    webhookSecret: "<random-webhook-secret>"

# Optional: trigger first build on helm upgrade
# tekton:
#   runInitialPipeline: true

# Workbench git credentials (when secrets.create=false):
#   ./scripts/bootstrap-workbench-git-credentials.sh
